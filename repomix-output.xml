<file path="web/src/hooks/useAuth.ts">
import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
import { ApiError, fetchJson } from "@/lib/api";

export type AuthUser = { email: string; first_name: string; last_name: string };
export type LoginInput = { email: string; password: string };
export type SignupInput = LoginInput & { first_name: string; last_name: string };

const ME = ["me"] as const;
const post = <T,>(path: string, body?: unknown) =>
  fetchJson<T>(path, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: body === undefined ? undefined : JSON.stringify(body),
  });

/** The signed-in user, or null when there is no valid session. */
export function useMe() {
  return useQuery<AuthUser | null>({
    queryKey: ME,
    queryFn: async () => {
      try {
        return await fetchJson<AuthUser>("/auth/me");
      } catch (error) {
        if (error instanceof ApiError && error.status === 401) return null;
        throw error;
      }
    },
    retry: false,
    staleTime: 5 * 60_000,
  });
}

export function useLogin() {
  const queryClient = useQueryClient();
  return useMutation<AuthUser, ApiError, LoginInput>({
    mutationFn: (body) => post<AuthUser>("/auth/login", body),
    onSuccess: (user) => queryClient.setQueryData(ME, user),
  });
}

export function useSignup() {
  const queryClient = useQueryClient();
  return useMutation<AuthUser, ApiError, SignupInput>({
    mutationFn: (body) => post<AuthUser>("/auth/signup", body),
    onSuccess: (user) => queryClient.setQueryData(ME, user),
  });
}

export function useLogout() {
  const queryClient = useQueryClient();
  return useMutation<unknown, ApiError>({
    mutationFn: () => post("/auth/logout"),
    onSettled: () => {
      // Drop everything the last person could see, then mark the session as gone.
      queryClient.removeQueries({ predicate: (q) => q.queryKey[0] !== ME[0] });
      queryClient.setQueryData(ME, null);
    },
  });
}
</file>

<file path="web/src/hooks/useEmployees.ts">
import { useQuery } from '@tanstack/react-query'
import { api } from '../api/client'

const PAGE_SIZE = 100

async function fetchPage(page: number) {
  const { data, error } = await api.GET('/employees', {
    params: { query: { page, page_size: PAGE_SIZE } },
  })
  if (error) throw error
  return data
}

type Page = Awaited<ReturnType<typeof fetchPage>>

/** Loads every employee, page by page, from the API. Nothing is mocked or cached locally. */
export function useEmployees() {
  return useQuery({
    queryKey: ['employees', 'all'],
    queryFn: async () => {
      const all: Page['items'] = []
      let page = 1
      let total = Number.POSITIVE_INFINITY

      while (all.length < total) {
        const result = await fetchPage(page)
        total = result.total
        if (result.items.length === 0) break
        all.push(...result.items)
        page += 1
      }
      return all
    },
  })
}
</file>

<file path="web/src/hooks/useTheme.ts">
import { useEffect, useState } from "react";

export type Theme = "dark" | "light";

const KEY = "lineari_theme";

function stored(): Theme | null {
  try {
    const v = localStorage.getItem(KEY);
    return v === "dark" || v === "light" ? v : null;
  } catch {
    return null;
  }
}

function preferred(): Theme {
  return window.matchMedia?.("(prefers-color-scheme: light)").matches ? "light" : "dark";
}

export function useTheme() {
  const [theme, setTheme] = useState<Theme>(() => stored() ?? preferred());

  useEffect(() => {
    const root = document.documentElement;
    root.classList.toggle("dark", theme === "dark");
    root.classList.toggle("light", theme === "light");
    try {
      localStorage.setItem(KEY, theme);
    } catch {
      /* private mode */
    }
  }, [theme]);

  const toggle = () => setTheme((t) => (t === "dark" ? "light" : "dark"));
  return { theme, setTheme, toggle };
}
