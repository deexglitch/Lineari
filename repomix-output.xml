@import "tailwindcss";

@custom-variant dark (&:where(.dark, .dark *));

/* 1. Brand palette — static, never changes */
@theme {
  --color-brand-teal: #0b6e6a;
  --color-brand-lime: #b6d777;
  --color-brand-coral: #f2674a;
  --color-brand-mist: #d5e3df;
  --color-brand-plum: #2b1d3a;

  --font-sans: "Manrope", ui-sans-serif, system-ui, sans-serif;
  --font-display: "Quicksand", ui-sans-serif, system-ui, sans-serif;
}

/* 2. Semantic tokens — these GENERATE the utilities (border-border, bg-background, etc.) */
@theme inline {
  --color-background: var(--bg);
  --color-foreground: var(--ink);
  --color-card: var(--bg-elev);
  --color-card-foreground: var(--ink);
  --color-primary: var(--accent);
  --color-primary-foreground: #ffffff;
  --color-secondary: var(--line);
  --color-secondary-foreground: var(--ink);
  --color-muted: #e3ecea;
  --color-muted-foreground: var(--ink-mute);
  --color-accent: var(--accent-2);
  --color-accent-foreground: var(--ink);
  --color-destructive: #c93c3c;
  --color-border: var(--line);   /* ← this makes border-border work */
  --color-input: var(--line);
  --color-ring: var(--accent);
}

/* 3. The actual variable values — light by default */
:root,
.light {
  --bg:        #eef4f2;
  --bg-elev:   #ffffff;
  --ink:       #10201e;
  --ink-soft:  #3d5350;
  --ink-mute:  #6a7d7a;
  --line:      #d5e3df;
  --accent:    #0b6e6a;
