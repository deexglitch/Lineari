import type { HierarchyNode } from "@/lib/types";

type OrganisationPageProps = {
  roots?: HierarchyNode[];
  isLoading?: boolean;
  isError?: boolean;
};

export default function OrganisationPage({ roots, isLoading, isError }: OrganisationPageProps) {
  const [query, setQuery] = useState("");
