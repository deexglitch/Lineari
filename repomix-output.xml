<file path="web/src/components/organisms/addemployeedialog.tsx">
import { useEffect, useRef, type FormEvent, type ReactNode } from "react";
import { UserPlus, X } from "@phosphor-icons/react";
import { cn } from "@/lib/utils";
import { useCreateEmployee } from "@/hooks/useCreateEmployee";

export type ManagerOption = { id: string; label: string };

const FRIENDLY_ERRORS: Record<string, string> = {
  duplicate_email: "That email address is already used by another employee.",
  duplicate_employee_number: "That employee number is already in use.",
  not_found: "The selected manager no longer exists. Pick another one.",
};

const inputClass =
  "rounded-xl bg-[#e0d6ec]/10 px-3 py-2.5 text-base font-normal text-[#e0d6ec] ring-1 ring-[#e0d6ec]/25 outline-none placeholder:text-[#e0d6ec]/45 focus:ring-2 focus:ring-[#e0d6ec]/60 [color-scheme:dark]";

function Field({ label, className, children }: { label: string; className?: string; children: ReactNode }) {
  return (
    <label className={cn("flex flex-col gap-1.5 text-sm font-semibold", className)}>
      {label}
      {children}
    </label>
  );
}

export function AddEmployeeDialog({
  open,
  onClose,
  managers,
}: {
  open: boolean;
  onClose: () => void;
  managers: ManagerOption[];
}) {
  const dialogRef = useRef<HTMLDialogElement>(null);
  const formRef = useRef<HTMLFormElement>(null);
  const create = useCreateEmployee();

  useEffect(() => {
    const dialog = dialogRef.current;
    if (!dialog) return;
    if (open && !dialog.open) dialog.showModal();
    if (!open && dialog.open) dialog.close();
  }, [open]);

  const close = () => {
    create.reset();
    formRef.current?.reset();
    onClose();
  };

  const onSubmit = (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault();
    const data = new FormData(event.currentTarget);
    const text = (key: string) => String(data.get(key) ?? "").trim();
    create.mutate(
      {
        name: text("name"),
        surname: text("surname"),
        email: text("email"),
        birth_date: text("birth_date"),
        emp_number: text("emp_number"),
        salary: Number(text("salary")),
        role: text("role"),
        manager_id: text("manager_id") || null,
      },
      { onSuccess: close },
    );
  };

  const error = create.error
    ? (FRIENDLY_ERRORS[create.error.code ?? ""] ?? create.error.message)
    : null;

  return (
    <dialog
      ref={dialogRef}
      onClose={close}
      onClick={(e) => e.target === e.currentTarget && close()}
      aria-labelledby="add-employee-title"
      className="m-auto w-[min(40rem,calc(100%-2rem))] max-h-[calc(100%-2rem)] overflow-y-auto rounded-[2rem] bg-linear-to-br from-[#2c2638]/90 to-[#0e0a16]/90 p-0 text-[#e0d6ec] shadow-2xl ring-1 ring-[#e0d6ec]/15 backdrop:bg-black/50 backdrop:backdrop-blur-sm"
    >
      <div className="p-6 md:p-8">
        <div className="flex items-start justify-between gap-4">
          <h2 id="add-employee-title" className="text-2xl font-extrabold tracking-tight">
            Add employee
          </h2>
          <button
            type="button"
            onClick={close}
            aria-label="Close"
            className="grid size-9 place-items-center rounded-full hover:bg-[#e0d6ec]/15 focus-visible:outline-2 focus-visible:outline-[#e0d6ec]/60"
          >
            <X size={18} weight="bold" aria-hidden />
          </button>
        </div>

        <form ref={formRef} onSubmit={onSubmit} className="mt-6 grid gap-4 sm:grid-cols-2">
          <Field label="First name">
            <input name="name" required maxLength={100} autoComplete="off" className={inputClass} />
          </Field>
          <Field label="Surname">
            <input name="surname" required maxLength={100} autoComplete="off" className={inputClass} />
          </Field>
          <Field label="Email" className="sm:col-span-2">
            <input name="email" type="email" required autoComplete="off" className={inputClass} />
          </Field>
          <Field label="Employee number">
            <input name="emp_number" required maxLength={32} autoComplete="off" className={inputClass} />
          </Field>
          <Field label="Role">
            <input name="role" required maxLength={100} autoComplete="off" className={inputClass} />
          </Field>
          <Field label="Date of birth">
            <input name="birth_date" type="date" required className={inputClass} />
          </Field>
          <Field label="Salary">
            <input name="salary" type="number" required min={0} step="0.01" inputMode="decimal" className={inputClass} />
          </Field>
          <Field label="Reports to" className="sm:col-span-2">
            <select name="manager_id" defaultValue="" className={inputClass}>
              <option value="">No manager</option>
              {managers.map((m) => (
                <option key={m.id} value={m.id}>
                  {m.label}
                </option>
              ))}
            </select>
          </Field>

          {error && (
            <p role="alert" className="rounded-xl bg-[#e0d6ec]/10 px-4 py-3 text-sm font-semibold ring-1 ring-[#e0d6ec]/30 sm:col-span-2">
              {error}
            </p>
          )}

          <div className="mt-2 flex flex-wrap justify-end gap-3 sm:col-span-2">
            <button
              type="button"
              onClick={close}
              className="rounded-full px-5 py-2.5 font-bold ring-1 ring-[#e0d6ec]/30 hover:bg-[#e0d6ec]/10 focus-visible:outline-2 focus-visible:outline-[#e0d6ec]/60"
            >
              Cancel
            </button>
            <button
              type="submit"
              disabled={create.isPending}
              className="inline-flex items-center gap-2 rounded-full bg-[#e0d6ec] px-5 py-2.5 font-bold text-[#1a1424] hover:bg-[#e0d6ec]/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#e0d6ec] disabled:opacity-60"
            >
              <UserPlus weight="bold" aria-hidden />
              {create.isPending ? "Adding employee…" : "Add employee"}
            </button>
          </div>
        </form>
      </div>
    </dialog>
  );
}
</file>

<file path="web/src/components/organisms/Org.css">
/* Top-down org chart. Connectors are drawn with borders on each <li>. */
.org-chart {
  --org-line: rgb(224 214 236 / 0.35); /* #e0d6ec */
  --org-gap: 28px;
}

.org-chart ul {
  position: relative;
  display: flex;
  justify-content: center;
  margin: 0;
  padding: var(--org-gap) 0 0;
  list-style: none;
}

.org-chart li {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--org-gap) 12px 0;
}

/* Horizontal bar across siblings, and the drop down into each child */
.org-chart li::before,
.org-chart li::after {
  content: "";
  position: absolute;
  top: 0;
  right: 50%;
  width: 50%;
  height: var(--org-gap);
  border-top: 1px solid var(--org-line);
}
.org-chart li::after {
  right: auto;
  left: 50%;
  border-left: 1px solid var(--org-line);
}

.org-chart li:only-child {
  padding-top: 0;
}
.org-chart li:only-child::before,
.org-chart li:only-child::after {
  display: none;
}

.org-chart li:first-child::before,
.org-chart li:last-child::after {
  border: 0 none;
}
.org-chart li:last-child::before {
  border-right: 1px solid var(--org-line);
  border-top: 1px solid var(--org-line);
  border-top-right-radius: 12px;
}
.org-chart li:first-child::after {
  border-top-left-radius: 12px;
}

/* Line from a manager down to their row of reports */
.org-chart ul ul::before {
  content: "";
  position: absolute;
  top: 0;
  left: 50%;
  height: var(--org-gap);
  border-left: 1px solid var(--org-line);
}

/* The outermost list holds the roots, so it gets no connectors */
.org-chart > ul {
  padding-top: 0;
}
.org-chart > ul > li {
  padding-top: 0;
}
.org-chart > ul > li::before,
.org-chart > ul > li::after {
  display: none;
}
</file>

<file path="web/src/components/organisms/organisation-tree.tsx">
import { Link } from "react-router-dom";
import { Table } from "@phosphor-icons/react";
import { buttonVariants } from "@/components/atoms/button";
import { Skeleton } from "@/components/atoms/skeleton";
import { PersonRow } from "@/components/molecules/person-row";
import type { HierarchyNode } from "@/lib/types";
import { cn } from "@/lib/utils";

type OrganisationTreeProps = {
  roots: HierarchyNode[];
  isLoading?: boolean;
  isError?: boolean;
  /** Search term used to force-open matches and to tune the empty message. */
  query: string;
  onClearSearch: () => void;
};

export function OrganisationTree({
  roots,
  isLoading,
  isError,
  query,
  onClearSearch,
}: OrganisationTreeProps) {
  const searching = query.trim().length > 0;

  const buttonClass = cn(
    buttonVariants({ size: "lg" }),
    "rounded-full bg-[#e0d6ec] font-bold text-[#1a1424] hover:bg-[#e0d6ec]/90",
  );

  if (isLoading) {
    return (
      <div className="space-y-3" aria-busy="true">
        {[0, 1, 2, 3].map((i) => (
          <Skeleton key={i} className="h-14 w-full rounded-2xl bg-[#e0d6ec]/15" />
        ))}
      </div>
    );
  }

  if (isError) {
    return (
      <div className="px-2 py-6">
        <p className="text-lg font-bold">Couldn’t load the organisation.</p>
        <p className="mt-1 text-sm text-[#e0d6ec]/70">
          Check that the API is running at localhost:8000, then refresh.
        </p>
      </div>
    );
  }

  if (roots.length > 0) {
    return (
      <ul aria-label="Organisation tree">
        {roots.map((node) => (
          <PersonRow key={node.id} node={node} depth={0} forceOpen={searching} />
        ))}
      </ul>
    );
  }

  return (
    <div className="flex flex-col items-start gap-4 px-2 py-6">
      <p className="text-lg font-bold">
        {searching ? `No one matches “${query.trim()}”.` : "No employees to show yet."}
      </p>
      {searching ? (
        <button type="button" onClick={onClearSearch} className={buttonClass}>
          Clear search
        </button>
      ) : (
        <Link to="/employees" className={buttonClass}>
          <Table weight="bold" aria-hidden />
          Add employees
        </Link>
      )}
    </div>
  );
}
</file>

<file path="web/src/components/organisms/top-nav.tsx">
import { forwardRef, type ComponentProps } from "react";
import { Link, useLocation } from "react-router-dom";
import {
  BookOpenText,
  SquaresFour,
  TreeStructure,
  Users,
} from "@phosphor-icons/react";
import PillNav from "@/components/vendor/PillNav";
import  LogoLight  from "@/assets/logo-light.webp"

/**
 * PillNav renders its links as <LinkComponent href=... />.
 * React Router wants `to`, so this adapter translates. It lives at module
 * level so its identity is stable between renders (PillNav's animation
 * engine measures the DOM, and remounting links would reset it).
 */
const RouterLink = forwardRef<HTMLAnchorElement, ComponentProps<"a">>(
  function RouterLink({ href = "/", ...props }, ref) {
    return <Link ref={ref} to={href} {...props} />;
  },
);

const iconProps = { weight: "bold", "aria-hidden": true } as const;

const items = [
  { label: "Overview", href: "/", icon: <SquaresFour {...iconProps} /> },
  { label: "Organisation", href: "/organisation", icon: <TreeStructure {...iconProps} /> },
  { label: "Employees", href: "/employees", icon: <Users {...iconProps} /> },
  { label: "Guide", href: "/guide", icon: <BookOpenText {...iconProps} /> },
];

function activeHrefFor(pathname: string) {
  const match = items.find(({ href }) =>
    href === "/" ? pathname === "/" : pathname.startsWith(href),
  );
  // An empty string keeps PillNav in controlled mode with nothing selected,
  // instead of falling back to its own click tracking on unknown routes.
  return match?.href ?? "";
}

export function TopNav() {
  const { pathname } = useLocation();

  return (
    <header className="sticky top-0 z-40 border-b border-white/10 bg-brand-plum pl-0! pr-4 md:pr-6 py-3 shadow-md">
      <div className="mx-auto flex max-w-7xl items-center gap-4">
        <Link
          to="/"
          aria-label="Lineari home"
          className="mr-auto pointer-events-auto flex shrink-0 items-center gap-4 rounded-full focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-teal"
        >
          <img src={LogoLight} alt="" className="h-11 w-auto object-contain" />
          
        </Link>

        {/* PillNav measures its parent's width to decide when to fold into a menu,
            so it gets its own flexible wrapper rather than sharing a row with the brand. */}
        <div className="pointer-events-auto flex min-w-0 flex-1 justify-end">
          <PillNav
            items={items}
            activeHref={activeHrefFor(pathname)}
            linkComponent={RouterLink}
            ariaLabel="Primary"
            theme="light"
            surface="glass"
