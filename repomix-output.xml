  --ink:       #f1f7f5;
  --ink-soft:  #cfe0dc;
  --ink-mute:  #8ba39e;
  --line:      rgb(213 227 223 / 0.18);
  --accent:    #0e857f;
  --accent-2:  #b6d777;
  --coral:     #f2674a;
  --glass-top: rgb(11 110 106 / 0.30);
  --glass-bot: rgb(5 20 19 / 0.55);
  --glass-edge: rgb(213 227 223 / 0.14);
  --glass-shine: rgb(213 227 223 / 0.22);
}

@layer base {
  * {
    border-color: var(--color-border);   /* no @apply needed */
  }
  html, body, #root { height: 100%; }
  body {
    margin: 0;
    background: var(--bg);
